{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=devdb;Username=dev;Password=dev"
  },
  "Aws": {
    "EndpointUrl": "http://localhost:5000",
    "SnsTopicArn": "arn:aws:sns:us-east-1:123456789012:booking-events"
  },
  "Jwt": {
    "Secret": "dev-only-signing-secret-not-for-production-1234567890",
    "Issuer": "BookingSystem",
    "Audience": "BookingSystem",
    "ExpiryMinutes": 60
  },
  "ReservationRules": {
    "BusinessHoursStart": "08:00:00",
    "BusinessHoursEnd": "18:00:00",
    "MaxDurationHours": 4
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  }
}
