# Copy this file to .env (gitignored) and fill in real values.
# Never commit real credentials — .env is excluded via .gitignore.

# Gmail SMTP app password for the notification sender (Booking.Worker).
# Generate one at https://myaccount.google.com/apppasswords — not your account password.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Switch api/worker's SNS/SQS from Moto to real AWS — see doc/notes/moto.md. Leave every var
# below blank/unset to keep using Moto (docker-compose's defaults). To go real: set
# AWS_ENDPOINT_URL= (blank, on purpose — the SDK falls back to RegionEndpoint) and fill in a
# real region + the ARN/URL of a topic and queue you've created in your AWS account (see
# doc/notes/moto.md for the queue-access-policy gotcha Moto doesn't force you to think about).
AWS_ENDPOINT_URL=
AWS_REGION=
AWS_SNS_TOPIC_ARN=
AWS_SQS_QUEUE_URL=

# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are the AWS SDK's own recognized env var names (not
# read via the Aws__ config prefix) — picked up automatically by its default credential
# provider chain. Ignored entirely while AWS_ENDPOINT_URL above still points at Moto.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
