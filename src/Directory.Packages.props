<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- EF Core / Postgres -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- Pinned explicitly: Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 transitively brings an
         older 10.0.4 Relational, conflicting with the 10.0.10 the other EF Core packages use. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <!-- Bumped to 10.0.11 to satisfy Microsoft.Extensions.Http's minimum, pulled in for the
         notification-provider HttpClient in Booking.Infrastructure. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <!-- Bumped to 10.0.11 alongside Configuration.Binder, same reason. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- Pinned explicitly: the default 2.0.0 has a known high-severity DoS vulnerability
         (GHSA-v5pm-xwqc-g5wc); patched in the 2.x line at 2.7.5+. Stay on 2.x — 3.x has
         breaking API changes incompatible with Microsoft.AspNetCore.OpenApi's source generator. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- AWS (SNS/SQS, mocked locally via Moto) -->
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.0.100.7" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.7" />
    <!-- Notification provider HttpClient (Booking.Infrastructure/External) -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- Redis caching (room-availability lookups) -->
    <PackageVersion Include="StackExchange.Redis" Version="3.1.13" />
    <!-- Real Gmail SMTP notification sender (Booking.Infrastructure/External) -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!-- Background jobs (Hangfire recurring job in Booking.Worker) -->
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <!-- Pinned explicitly: Hangfire.Core transitively brings Newtonsoft.Json 11.0.1, which has a
         known high-severity ReDoS vulnerability (GHSA-5crp-9r3c-p9vr). -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Auth (JWT + BCrypt password hashing) -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <!-- API docs / demo UI -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.18" />
    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="WireMock.Net" Version="2.15.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Pinned to 7.2.2: FluentAssertions 8+ requires a paid commercial license. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
  </ItemGroup>
</Project>